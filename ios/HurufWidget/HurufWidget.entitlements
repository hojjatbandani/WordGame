<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- الطريق الوحيد لمشاركة UserDefaults بين التطبيق والإضافة.
	     يجب أن يطابق حرفيا HomeWidgetService.appGroupId في Flutter
	     وRunner.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.huruf.huruf.widget</string>
	</array>
</dict>
</plist>
