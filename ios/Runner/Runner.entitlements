<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- نفس المجموعة المعلَنة في HurufWidget.entitlements — بلا تطابقهما
	     تكتب Flutter في تخزين لا تقرؤه الودجة فتبقى فارغة أبدا. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.huruf.huruf.widget</string>
	</array>
</dict>
</plist>
