<?xml version="1.0" encoding="utf-8"?>
<!-- الحجم الكبير (4×4): «المكافآت» مجمّعة — الطبقات الثلاث معا بحالة
     كلٍّ منها، ثم إحصاءات الرحلة، ثم السلسلة وزرّ النداء.

     كل صفّ طبقة قابل للنقر وحده ويفتح بطاقتها بعينها في شاشة الجوائز
     (huruf://rewards/daily|weekly|monthly). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/huruf_widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/huruf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start"/>

        <TextView
            android:id="@+id/widget_diamonds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/huruf_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:gravity="end"/>
    </LinearLayout>

    <!-- صفوف الطبقات الثلاث — نفس البنية، تُملأ بالترتيب daily/weekly/monthly -->
    <LinearLayout
        android:id="@+id/widget_tier_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@drawable/huruf_widget_card"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_tier_0_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/huruf_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"/>
            <TextView
                android:id="@+id/widget_tier_0_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/huruf_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_tier_0_dots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"/>

        <TextView
            android:id="@+id/widget_tier_0_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/huruf_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_tier_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:background="@drawable/huruf_widget_card"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_tier_1_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/huruf_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"/>
            <TextView
                android:id="@+id/widget_tier_1_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/huruf_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_tier_1_dots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"/>

        <TextView
            android:id="@+id/widget_tier_1_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/huruf_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_tier_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:background="@drawable/huruf_widget_card"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_tier_2_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/huruf_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"/>
            <TextView
                android:id="@+id/widget_tier_2_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/huruf_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:gravity="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_tier_2_dots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"/>

        <TextView
            android:id="@+id/widget_tier_2_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/huruf_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/huruf_text_secondary"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="start"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/huruf_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start"/>

        <TextView
            android:id="@+id/widget_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/huruf_widget_cta"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textColor="@color/huruf_bg_top"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"/>
    </LinearLayout>
</LinearLayout>
