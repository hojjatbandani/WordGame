<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية الودجة: نفس تدرّج HurufTheme.bgGradient ونفس نصف قطر
     البطاقة (rCard = 24dp)، مع خط شعرة أبيض خافت كحدّ GlassCard. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/huruf_bg_top"
        android:endColor="@color/huruf_bg_bottom"
        android:type="linear"/>
    <corners android:radius="24dp"/>
    <stroke android:width="1dp" android:color="@color/huruf_hairline"/>
</shape>
