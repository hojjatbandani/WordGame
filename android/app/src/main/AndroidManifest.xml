<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- معرّف الإعلانات: حزمة Google Mobile Ads تعلن AD_ID بنفسها فيُدمج في
         البيان النهائي. جمهور اللعبة يشمل الأطفال ولا بوّابة عمر فيها، فكل
         لاعب قد يكون طفلا: لا نطلب المعرّف إطلاقا (سياسة العائلات: التطبيق
         الموجَّه للأطفال لا يطلب AD_ID على API 33+ ولا يرسل AAID). كل طلب
         إعلان يحمل معاملة الطفل أيضا (lib/data/ads/admob_ad_service.dart).
         لا تُزِل هذا السطر قبل إضافة بوّابة عمر محايدة ومراجعة إعلان
         «معرّف الإعلانات» في Play Console. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <!-- وللسبب نفسه واجهات Privacy Sandbox الإعلانية التي تعلنها الحزمة:
         المواضيع (استهداف بحسب الاهتمامات) وإسناد الإعلانات ومعرّفها. -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove"/>
    <!-- التذكيرات المحلية: POST_NOTIFICATIONS وVIBRATE يضيفهما
         flutter_local_notifications نفسه عبر دمج البيانات. الباقي هنا
         لأن الجدولة تعيش أياما: بلا RECEIVE_BOOT_COMPLETED يفقد الجهاز
         كل تذكير مجدول عند أول إعادة تشغيل. ولا نطلب SCHEDULE_EXACT_ALARM
         ولا USE_EXACT_ALARM عمدا — Google Play تحصرهما في تطبيقات
         المنبّهات والتقويم، ولا تذكير لعبة يحتاج دقّة الثانية. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- كانت معلنة في بيان debug/profile فقط (وهو ما يولّده قالب Flutter
         لأداة التطوير)، فيعمل كل شيء أثناء التطوير وتخرج نسخة الإصدار
         بلا إنترنت إطلاقا: Supabase والتحدي اليومي والأصدقاء والدعوات
         والإعداد عن بعد كلها تفشل بصمت لكل لاعب حقيقي. لا مُلحق يدمجها
         نيابة عنّا — تحقّقنا من البيان المدموج للإصدار. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="حروف"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- روابط الدعوة: huruf.site/i/CODE (HTTPS فقط)
                 autoVerify يجعل النظام يفتح الرابط في التطبيق مباشرة بلا
                 نافذة اختيار، وشرطه رفع /.well-known/assetlinks.json على
                 كل مضيف هنا ببصمة توقيع الإصدار، بلا أي إعادة توجيه — أداة
                 التحقق لا تتبع التحويلات. www مضاف لأن النطاق المجرّد يحوّل
                 إليه (308) على Vercel، فهو المضيف الذي يصل إليه الزائر فعلا.
                 قبل رفع الملف يبقى الرابط عاملا لكن عبر نافذة الاختيار،
                 ويبقى إدخال الرمز يدويا مسارا كاملا على أي حال (راجع
                 lib/core/referral_link.dart). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="huruf.site"/>
                <data android:host="www.huruf.site"/>
                <data android:pathPrefix="/i/"/>
            </intent-filter>

            <!-- خطّة ثانية: مخطّط مخصّص يعمل حيث لا تُفتح روابط الويب -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="huruf"/>
            </intent-filter>
        </activity>
        <!-- ودجة الشاشة الرئيسية (المكافآت اليومية/الأسبوعية/الشهرية).
             exported=true إلزامي: مضيف الشاشة الرئيسية عملية أخرى
             تستدعي المزوّد، وبدونها لا تظهر الودجة في المنتقي أصلا.
             لا تقبل الودجة أي أمر يغيّر حالة اللعبة — هي طبقة عرض
             تقرأ لقطة وتفتح التطبيق لا أكثر. -->
        <receiver
            android:name=".HurufWidgetProvider"
            android:label="@string/huruf_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/huruf_widget_info"/>
        </receiver>

        <!-- مستقبِل إطلاق التذكير المجدول، ومستقبِل يعيد جدولة ما تبقّى
             بعد إقلاع الجهاز أو تحديث التطبيق -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- معرّف تطبيق AdMob. هذا معرّف Google الاختباري الرسمي — استبدله
             بمعرّف تطبيقك من لوحة AdMob (Apps → App settings → App ID،
             بصيغة ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY) مع معرّفات الوحدات في
             lib/data/ads/admob_ids.dart، في الإصدار نفسه. نسخة إصدار بلا
             معرّفات وحدات حقيقية لا تعرض أي إعلان (lib/main.dart)، لكن الحزمة
             تشترط وجود هذا المعرّف في البيان وإلا انهار التطبيق عند الإقلاع.
             test/ads/android_manifest_ads_test.dart يتحقّق أن المعرّفين من
             حساب الناشر نفسه. -->
        <!-- لا تُشغِّل «High-engagement ads» في لوحة AdMob (App settings) لهذا
             التطبيق: تشغيلها يرفع مهلة إغلاق البيني من 5 ثوان إلى 12، وهذا
             ما ترفضه سياسة العائلات (lib/data/ads/ad_policy.dart). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3678223996715179~1831890095"/>

        <!-- PostHog (lib/data/analytics/posthog_sink.dart) يُهيَّأ من Dart
             بإعداداته (بلا تسجيل جلسات — جمهور اللعبة يشمل الأطفال). بلا
             هذا السطر يحاول الملحق تهيئة نفسه تلقائيا من البيان قبل ذلك.
             test/ads/android_manifest_ads_test.dart يمنع حذفه. -->
        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- فتح صفحة التطبيق في متجر Play لطلب التقييم (رابط market://).
             بلا هذا الإعلان لا يرى التطبيق تطبيق المتجر على أندرويد 11+
             فيسقط الطلب على رابط الويب. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="market"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
